      "id": "ef66ea34"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "log_reg = LogisticRegressionCV(cv=5,Cs=[0.01,0.1,1,10],max_iter=5000,penalty=\"l1\",solver=\"saga\")\n",
        "log_reg.fit(X_train,y_train)\n",
        "print(\"Training accuracy:\", round(log_reg.score(X_train,y_train), 3))\n",
        "print(\"Chosen regularization strength(s) (C):\", log_reg.C_)\n",
        "print(\"Test accuracy (the number that actually matters):\", round(log_reg.score(X_test,y_test), 3))"
