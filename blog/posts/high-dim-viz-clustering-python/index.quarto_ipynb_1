    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from yellowbrick.cluster import SilhouetteVisualizer\n",
        "\n",
        "# NOTE: Yellowbrick was written against an older version of scikit-learn's internal API.\n",
        "# Newer scikit-learn versions removed the `_estimator_type` attribute that Yellowbrick\n",
        "# checks for, causing a spurious \"not a clustering estimator\" error. Setting this\n",
        "# attribute manually on an already-fitted model works around the incompatibility\n",
        "# without changing any actual clustering behavior.\n",
        "def as_clusterer(fitted_model):\n",
        "    fitted_model._estimator_type = \"clusterer\"\n",
        "    return fitted_model"
